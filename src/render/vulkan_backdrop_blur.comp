#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D target_image;
layout(set = 0, binding = 8) uniform sampler2D source_image;

layout(push_constant) uniform Blur {
    uvec4 sizes; // logical source width/height, destination width/height
    uvec4 damage;
    uvec4 filter_info; // upsample, offset bits, unused, unused
} frame;

// Manual bilinear filtering clamps to the logical level size in `sizes`,
// not the backing image, because the levels are shared and may be larger
// than this target's pyramid.
vec4 sampled(vec2 position) {
    ivec2 base = ivec2(floor(position));
    ivec2 limit = ivec2(frame.sizes.xy) - 1;
    vec2 f = fract(position);
    return mix(
        mix(texelFetch(source_image, clamp(base, ivec2(0), limit), 0),
            texelFetch(source_image, clamp(base + ivec2(1, 0), ivec2(0), limit), 0), f.x),
        mix(texelFetch(source_image, clamp(base + ivec2(0, 1), ivec2(0), limit), 0),
            texelFetch(source_image, clamp(base + ivec2(1, 1), ivec2(0), limit), 0), f.x), f.y);
}

void main() {
    uvec2 local = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(local, frame.damage.zw))) return;
    ivec2 pixel = ivec2(frame.damage.xy + local);
    vec2 position = (vec2(pixel) + 0.5) * vec2(frame.sizes.xy) / vec2(frame.sizes.zw) - 0.5;
    float offset = uintBitsToFloat(frame.filter_info.y);
    vec4 corners = sampled(position + vec2(-offset, -offset))
        + sampled(position + vec2(offset, -offset))
        + sampled(position + vec2(-offset, offset))
        + sampled(position + vec2(offset, offset));
    vec4 color;
    if (frame.filter_info.x == 0u) {
        color = (4.0 * sampled(position) + corners) / 8.0;
    } else {
        color = (2.0 * corners
            + sampled(position + vec2(-2.0 * offset, 0.0))
            + sampled(position + vec2(2.0 * offset, 0.0))
            + sampled(position + vec2(0.0, -2.0 * offset))
            + sampled(position + vec2(0.0, 2.0 * offset))) / 12.0;
    }
    imageStore(target_image, pixel, color);
}
