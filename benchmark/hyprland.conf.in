monitor = @OUTPUT@,@MODE_REFRESH@,0x0,1

animations {
    enabled = false
}

decoration {
    rounding = 0
    shadow {
        enabled = false
    }
    blur {
        enabled = false
    }
}

general {
    gaps_in = 0
    gaps_out = 0
    border_size = 0
}

misc {
    disable_hyprland_logo = true
    disable_splash_rendering = true
    force_default_wallpaper = 0
    vrr = 0
}

xwayland {
    enabled = false
}

render {
    direct_scanout = @DIRECT_SCANOUT@
}
